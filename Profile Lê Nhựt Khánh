</div>

<div id="lightbox" onclick="this.style.display='none'" style="display: none; position: fixed; z-index: 10000; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); justify-content: center; align-items: center; backdrop-filter: blur(10px);">
    <img id="fullImg" src="" style="max-width: 90%; max-height: 85%; border-radius: 15px;">
</div>

<script>
    const audio = document.getElementById('audio-element');
    const playBtn = document.getElementById('play-btn');
    const visualizer = document.getElementById('visualizer');
    const progress = document.getElementById('progress-current');
    const musicContainer = document.getElementById('music-container');
    const openBtn = document.getElementById('open-music-btn');

    function toggleShop() {
        const shop = document.getElementById('shop-overlay');
        const wrapper = document.getElementById('main-wrapper');
        shop.classList.toggle('active');
        wrapper.classList.toggle('hidden');
    }

    function closeMusicPlayer() {
        musicContainer.style.transform = 'translateX(400px)';
        musicContainer.style.opacity = '0';
        setTimeout(() => {
            musicContainer.style.display = 'none';
            openBtn.style.display = 'flex';
        }, 400);
    }

    function openMusicPlayer() {
        openBtn.style.display = 'none';
        musicContainer.style.display = 'block';
        setTimeout(() => {
            musicContainer.style.transform = 'translateX(0)';
            musicContainer.style.opacity = '1';
        }, 10);
    }

    playBtn.onclick = () => {
        if (audio.paused) {
            audio.play().catch(() => {});
            playBtn.innerHTML = '<i class="fas fa-pause"></i>';
            visualizer.classList.add('playing');
        } else {
            audio.pause();
            playBtn.innerHTML = '<i class="fas fa-play"></i>';
            visualizer.classList.remove('playing');
        }
    };

    /* TỐI ƯU: Ép phát lại liên tiếp để nhạc không bao giờ dừng */
    audio.onended = () => {
        audio.currentTime = 0;
        audio.play();
        visualizer.classList.add('playing');
        playBtn.innerHTML = '<i class="fas fa-pause"></i>';
    };

    function seekAudio(seconds) {
        if (!audio.duration) return;
        let targetTime = audio.currentTime + seconds;
        if (targetTime < 0) targetTime = 0;
        if (targetTime > audio.duration) targetTime = audio.duration;
        const wasPlaying = !audio.paused;
        visualizer.classList.remove('playing');
        audio.currentTime = targetTime;
        if (wasPlaying) {
            audio.play();
            visualizer.classList.add('playing');
            playBtn.innerHTML = '<i class="fas fa-pause"></i>';
        }
    }

    audio.ontimeupdate = () => {
        if (audio.duration) {
            const p = (audio.currentTime / audio.duration) * 100;
            progress.style.width = p + '%';
        }
    };

    /* TỐI ƯU: Giảm số lượng ngôi sao xuống 80 để giảm lag mobile */
    const starsLayer = document.getElementById('stars-layer');
    for (let i = 0; i < 80; i++) {
        const star = document.createElement('div');
        const isYellow = Math.random() > 0.5;
        star.className = isYellow ? 'star-base star-yellow' : 'star-base star-white';
        const size = Math.random() * 8 + 3 + 'px';
        star.style.width = size;
        star.style.height = size;
        star.style.left = Math.random() * 100 + 'vw';
        star.style.top = Math.random() * 100 + 'vh';
        star.style.setProperty('--t', (Math.random() * 3 + 1.5) + 's');
        star.style.animationDelay = Math.random() * 5 + 's';
        starsLayer.appendChild(star);
    }

    /* TỐI ƯU: Giảm tần suất trăng rơi */
    function createFalling() {
        const item = document.createElement('div');
        item.classList.add('moon-fall');
        item.innerHTML = '🌙';
        item.style.left = Math.random() * 100 + 'vw';
        item.style.animationDuration = Math.random() * 6 + 5 + 's';
        item.style.opacity = Math.random() * 0.5 + 0.3;
        document.body.appendChild(item);
        setTimeout(() => item.remove(), 10000);
    }
    setInterval(createFalling, 1200);

    /* TỐI ƯU: Thiên thạch mượt hơn bằng cách giảm số lượng */
    const canvas = document.getElementById('fw-canvas');
    const ctx = canvas.getContext('2d');
    let meteors = [];

    function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    class Meteor {
        constructor() { this.reset(); }
        reset() {
            this.x = Math.random() * canvas.width * 1.2;
            this.y = -Math.random() * 100;
            this.length = Math.random() * 40 + 30;
            this.speed = Math.random() * 2 + 1;
            this.color = `hsla(${Math.random() * 360}, 100%, 75%, `;
        }
        update() {
            this.x -= this.speed;
            this.y += this.speed;
            if (this.y > canvas.height + 100 || this.x < -100) {
                this.reset();
            }
        }
        draw() {
            let gradient = ctx.createLinearGradient(this.x, this.y, this.x + this.length, this.y - this.length);
            gradient.addColorStop(0, this.color + '0.6)');
            gradient.addColorStop(1, 'transparent');
            ctx.beginPath();
            ctx.strokeStyle = gradient;
            ctx.lineWidth = 1.2;
            ctx.lineCap = 'round';
            ctx.moveTo(this.x, this.y);
            ctx.lineTo(this.x + this.length, this.y - this.length);
            ctx.stroke();
        }
    }
    for (let i = 0; i < 3; i++) {
        meteors.push(new Meteor());
    }

    function loop() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        meteors.forEach(m => { m.update(); m.draw(); });
        requestAnimationFrame(loop);
    }
    loop();

    function openFullImg(imgSrc) {
        document.getElementById('fullImg').src = imgSrc;
        document.getElementById('lightbox').style.display = 'flex';
    }
</script>

</body>
</html>
