</div>

<div class="open-music-btn" id="open-music-btn" onclick="openMusicPlayer()"><i class="fas fa-music"></i></div>

<div class="music-player" id="music-container">
    <div class="close-music" onclick="closeMusicPlayer()"><i class="fas fa-times"></i></div>
    <div class="player-header">
