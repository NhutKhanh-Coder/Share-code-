<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lê Nhựt Khánh - Link in Bio</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        :root {
            /* Tông màu Tím Lofi Chill Cloud */
            --bg-deep: #0f0720; 
            --bg-mid: #1a1a2e;
            --container-purple: rgba(20, 10, 35, 0.85);
            --main-accent: #d946ef;
            --pure-white: #ffffff;
            --card-gray: rgba(255, 255, 255, 0.08);
            --accent-blue: #a855f7;
            /* Màu mây đặc trưng */
            --cloud-dark: #2e1a5e;
            --cloud-light: #bf5af2;
            /* Dải màu LED 7 màu chuyên dụng */
            --led-7color: linear-gradient(90deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #8b00ff, #ff0000);
        }

        body {
            margin: 0; padding: 0;
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-deep);
            background-image: 
                radial-gradient(1px 1px at 20px 30px, #fff, rgba(0,0,0,0)),
                radial-gradient(1.5px 1.5px at 100px 150px, #fff, rgba(0,0,0,0)),
                radial-gradient(2px 2px at 50px 160px, #ddd, rgba(0,0,0,0)),
                radial-gradient(1px 1px at 180px 220px, #fff, rgba(0,0,0,0));
            background-repeat: repeat;
            background-size: 250px 250px;
            display: flex; justify-content: center;
            min-height: 100vh; color: var(--pure-white);
            overflow-x: hidden;
            position: relative;
        }

        /* TỐI ƯU: Ép xử lý bằng GPU để hết lag */
        .fixed-moon, .cloud-group, .avatar-on-text, .link-card, .music-player, .moon-fall {
            transform: translateZ(0);
            will-change: transform;
        }

        /* --- PHẦN MẶT TRĂNG CỐ ĐỊNH --- */
        .fixed-moon {
            position: fixed;
            top: 50px;
            right: 15%;
            width: 80px;
            height: 80px;
            background-color: transparent;
            border-radius: 50%;
            box-shadow: -15px 10px 0 0 #fef08a; 
            z-index: -3; 
            filter: drop-shadow(0 0 25px rgba(254, 240, 138, 0.5));
            transform: rotate(-15deg);
        }

        .lofi-clouds {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: -1;
            pointer-events: none;
        }

        .cloud-group { position: absolute; }
        .cloud-base {
            width: 180px; height: 50px;
            background: var(--cloud-dark);
            border-radius: 50px;
            position: relative;
            filter: drop-shadow(0 0 15px rgba(191, 90, 242, 0.2));
        }

        .cloud-base::before, .cloud-base::after {
            content: ''; position: absolute;
            background: inherit; border-radius: 50%;
        }

        .cloud-base::before { width: 80px; height: 80px; top: -40px; left: 20px; }
        .cloud-base::after { width: 100px; height: 100px; top: -55px; left: 60px; }

        .cloud-light {
            position: absolute; top: -58px; left: 60px;
            width: 90px; height: 20px;
            background: var(--cloud-light);
            filter: blur(8px); border-radius: 50%;
            opacity: 0.8; z-index: 2;
        }

        .c1 { top: 10%; left: 5%; transform: scale(0.7); }
        .c2 { top: 35%; right: 5%; transform: scale(1.1) rotateY(180deg); }
        .c3 { bottom: 15%; left: 10%; transform: scale(0.9); opacity: 0.6; }
        .c4 { top: 70%; right: 10%; transform: scale(0.6); opacity: 0.4; }

        @keyframes led-flow {
            0% { background-position: 0% 50%; }
            100% { background-position: 200% 50%; }
        }

        @keyframes rotate-led {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @keyframes led-blink-border {
            0%, 100% { border-color: #ff0000; box-shadow: 0 0 10px #ff0000; }
            14% { border-color: #ff7f00; }
            28% { border-color: #ffff00; }
            42% { border-color: #00ff00; }
            56% { border-color: #0000ff; }
            70% { border-color: #4b0082; }
            84% { border-color: #8b00ff; box-shadow: 0 0 10px #8b00ff; }
        }

        .avatar-on-text {
            width: 120px; height: 120px;
            margin: -60px auto 10px;
            position: relative; z-index: 15;
            display: flex; justify-content: center; align-items: center;
            border-radius: 50%; overflow: hidden;
            background: #000;
        }

        .avatar-on-text::before {
            content: ""; position: absolute;
            width: 150%; height: 150%;
            background: conic-gradient(#ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #8b00ff, #ff0000);
            animation: rotate-led 2s linear infinite;
        }

        .avatar-circle {
            width: calc(100% - 8px); height: calc(100% - 8px);
            object-fit: cover; border-radius: 50%;
            position: relative; z-index: 2;
            background-color: #000; border: 2px solid #000;
        }

        .profile-info { text-align: center; padding: 0 20px; position: relative; z-index: 15; }

        .profile-name { 
            font-size: 30px; font-weight: 800; margin: 10px 0 0; letter-spacing: 1px;
            background: linear-gradient(to right, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #8b00ff, #ff0000);
            background-size: 200% auto;
            color: transparent;
            -webkit-background-clip: text;
            background-clip: text;
            animation: led-flow 3s linear infinite;
            display: block; width: 100%;
        }

        .profile-desc { font-size: 14px; color: #e2e8f0; margin: 5px 0 25px; font-weight: 600; text-transform: uppercase; letter-spacing: 2px; }

        .links-wrapper { padding: 10px 25px; }
        .link-card {
            display: flex; align-items: center;
            background-color: var(--card-gray); color: #fff;
            text-decoration: none; padding: 14px 18px;
            border-radius: 20px; margin-bottom: 15px;
            transition: 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
            border: 1px solid rgba(255,255,255,0.1); width: 100%;
            position: relative;
        }
        .link-card:hover { 
            background: rgba(168, 85, 247, 0.2); 
            border-color: var(--main-accent); 
            transform: scale(1.02);
            box-shadow: 0 5px 20px rgba(217, 70, 239, 0.3);
        }

        .icon-box {
            width: 42px; height: 42px;
            background: rgba(15, 7, 32, 0.6);
            border-radius: 12px; display: flex;
            align-items: center; justify-content: center;
            border: 1px solid rgba(255,255,255,0.1);
            overflow: hidden;
            z-index: 2;
        }
        .icon-img { width: 100%; height: 100%; object-fit: cover; }
        .fa-tiktok { color: #fff; font-size: 22px; }
        .fa-shop { color: #ff0000 !important; font-size: 22px; }

        .text-content { flex: 1; display: flex; justify-content: center; align-items: center; margin-right: 42px; }
        .title { font-weight: 600; font-size: 15px; text-transform: uppercase; letter-spacing: 1.5px; }

        .feedback-section {
            margin: 20px 25px; background: rgba(0, 0, 0, 0.2);
            padding: 20px; border-radius: 25px;
            border: 1px solid rgba(255,255,255,0.05);
        }
        .feedback-title {
            color: var(--main-accent); font-size: 14px; font-weight: 800;
            margin-bottom: 20px; display: flex;
            align-items: center; gap: 10px;
            text-transform: uppercase; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;
        }
        .feedback-columns { column-count: 2; column-gap: 12px; }

        .feedback-item {
            display: inline-block; width: 100%; margin-bottom: 12px; border-radius: 15px;
            overflow: hidden; 
            border: 3px solid #ff0000; 
            transition: 0.3s;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            animation: led-blink-border 4s linear infinite;
        }
        .feedback-item img { width: 100%; display: block; height: auto; transition: 0.5s; }
        .feedback-item:hover img { transform: scale(1.1); }

        /* --- TRANG BÁN HÀNG NHỎ LẠI --- */
        #shop-overlay {
            position: fixed;
            top: 50%; left: 50%;
            width: 90%; max-width: 400px;
            max-height: 85vh;
            background: rgba(20, 10, 35, 0.98);
            z-index: 20000;
            border: 2px solid transparent;
            border-radius: 30px;
            border-image: var(--led-7color);
            border-image-slice: 1;
            transform: translate(-50%, -50%) scale(0.8);
            opacity: 0;
            visibility: hidden;
            transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            padding: 25px;
            overflow-y: auto;
            backdrop-filter: blur(20px);
            box-shadow: 0 0 50px rgba(0,0,0,0.9);
        }

        #shop-overlay.active {
            opacity: 1;
            visibility: visible;
            transform: translate(-50%, -50%) scale(1);
        }

        .main-content-wrapper {
            transition: 0.5s ease;
            width: 100%;
            display: flex;
            justify-content: center;
        }

        .main-content-wrapper.hidden {
            filter: blur(8px) grayscale(0.5);
            opacity: 0.2;
            pointer-events: none;
        }

        .shop-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .shop-title-text {
            font-size: 20px; font-weight: 800; text-transform: uppercase;
            background: var(--led-7color); -webkit-background-clip: text;
            background-clip: text; color: transparent; background-size: 200%;
            animation: led-flow 3s linear infinite;
        }

        .close-shop {
            font-size: 22px; color: #fff; cursor: pointer;
            width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;
            background: rgba(255,255,255,0.1); border-radius: 50%;
        }

        .shop-grid {
            display: grid; grid-template-columns: 1fr; gap: 15px;
        }

        .shop-card {
            background: rgba(255, 255, 255, 0.05); border-radius: 20px;
            padding: 20px; text-align: left; border: 1px solid rgba(255,255,255,0.1);
            transition: 0.3s; display: flex; align-items: center; gap: 15px;
        }
        
        .shop-card:hover {
            border-color: var(--main-accent);
            background: rgba(217, 70, 239, 0.1);
        }

        .shop-logo-img { 
            width: 50px; 
            height: 50px; 
            object-fit: cover; 
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.2);
        }
        
        .shop-card-info { flex: 1; }
        .shop-card h3 { font-size: 15px; margin: 0; text-transform: uppercase; color: #fff; letter-spacing: 1px; }
        .shop-card p { font-size: 11px; color: #cbd5e1; margin: 4px 0 0; line-height: 1.4; font-style: italic; }

        .buy-btn {
            background: var(--led-7color); background-size: 200%;
            border: none; color: #fff; padding: 10px 18px; border-radius: 10px;
            font-weight: 700; font-size: 12px; text-transform: uppercase;
            cursor: pointer; animation: led-flow 3s linear infinite;
            white-space: nowrap;
        }

        /* --- HIỆU ỨNG NHẠC --- */
        .visualizer { display: flex; align-items: flex-end; justify-content: center; gap: 3px; height: 25px; margin-bottom: 12px; }
        .bar { width: 3px; border-radius: 2px; height: 5px; }
        .bar:nth-child(1) { background: #ff0000; }
        .bar:nth-child(2) { background: #ff7f00; }
        .bar:nth-child(3) { background: #ffff00; }
        .bar:nth-child(4) { background: #00ff00; }
        .bar:nth-child(5) { background: #00ffff; }
        .bar:nth-child(6) { background: #0000ff; }
        .bar:nth-child(7) { background: #4b0082; }
        .bar:nth-child(8) { background: #8b00ff; }

        .playing .bar { animation: wave 0.5s infinite ease-in-out alternate; }
        @keyframes wave { from { height: 5px; } to { height: 20px; } }

        .music-player {
            position: fixed; bottom: 20px; right: 20px; width: 280px;
            background: rgba(30, 10, 50, 0.9); border: 1px solid rgba(168, 85, 247, 0.3);
            border-radius: 15px; padding: 15px; z-index: 10001; color: white;
            backdrop-filter: blur(15px); box-shadow: 0 10px 40px rgba(0,0,0,0.6);
            transition: 0.4s;
        }
        
        .close-music { position: absolute; top: 5px; right: 10px; cursor: pointer; font-size: 18px; color: rgba(255,255,255,0.5); transition: 0.3s; }
        .close-music:hover { color: #ff0000; }

        .open-music-btn {
            position: fixed; bottom: 20px; right: 20px; width: 45px; height: 45px;
            background: var(--led-7color); background-size: 200% auto; border-radius: 50%;
            display: none; align-items: center; justify-content: center;
            cursor: pointer; z-index: 10000;
            box-shadow: 0 0 15px var(--main-accent);
            animation: led-flow 3s linear infinite, bounce 2s infinite;
        }
        @keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }

        /* THANH TIẾN TRÌNH KHÔNG CHO CLICK TUA */
        .progress-bar-container { width: 100%; height: 12px; display: flex; align-items: center; cursor: default; }
        .progress-bar { width: 100%; height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; position: relative; overflow: hidden; }
        .progress-current { height: 100%; background: var(--led-7color); background-size: 200% auto; width: 0%; border-radius: 2px; animation: led-flow 2s linear infinite; }

        .controls { display: flex; align-items: center; justify-content: center; gap: 20px; margin-top: 10px; }
        .play-pause { width: 35px; height: 35px; background: var(--pure-white); color: #000; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; }
        
        /* NÚT TUA MỚI */
        .seek-btn { font-size: 18px; color: rgba(255,255,255,0.8); cursor: pointer; transition: 0.2s; }
        .seek-btn:hover { color: var(--main-accent); transform: scale(1.2); }
        .seek-btn:active { transform: scale(0.9); }

        .moon-fall {
            position: fixed; top: -10vh; z-index: 9999; pointer-events: none; color: #fef08a; 
            font-size: 22px; animation: moon-fall-anim linear infinite; text-shadow: 0 0 8px rgba(254, 240, 138, 0.6);
        }
        @keyframes moon-fall-anim { 0% { transform: translateY(0) rotate(0deg); opacity: 0; } 10% { opacity: 0.8; } 100% { transform: translateY(110vh) rotate(180deg); opacity: 0; } }

        #fw-canvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9998; pointer-events: none; opacity: 0.8; }
        .star-base { position: fixed; z-index: -2; pointer-events: none; animation: twinkle var(--t) infinite alternate ease-in-out; }
        .star-yellow { background-color: #ffd700; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
        .star-white { background-color: #ffffff; clip-path: polygon(50% 0%, 60% 20%, 98% 35%, 60% 50%, 79% 98%, 50% 70%, 21% 98%, 40% 50%, 2% 35%, 40% 20%); }
        @keyframes twinkle { 0% { opacity: 0.2; transform: scale(0.4); } 100% { opacity: 1; transform: scale(1); filter: drop-shadow(0 0 8px currentColor); } }

        * { box-sizing: border-box; }

        .beacons-container {
            width: 100%; max-width: 480px; background-color: var(--container-purple); 
            min-height: 100vh; position: relative; padding-bottom: 50px;
            box-shadow: 0 0 60px rgba(0,0,0,0.7); z-index: 10;
            border-left: 1px solid rgba(255,255,255,0.05); border-right: 1px solid rgba(255,255,255,0.05);
            backdrop-filter: blur(12px);
        }

        .header-section { width: 100%; height: 380px; position: relative; overflow: hidden; }
        .main-photo { width: 100%; height: 100%; object-fit: cover; mask-image: linear-gradient(to bottom, black 80%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 80%, transparent 100%); }
        #lightbox { border: 3px solid #fff; }
        
        .status-online { color: #4ade80 !important; font-weight: 800; text-shadow: 0 0 10px rgba(74, 222, 128, 0.3); }
        .song-title { color: var(--accent-blue) !important; font-weight: bold; }
    </style>
</head>
<body>

<div class="fixed-moon"></div>
<div id="stars-layer"></div>
<div class="lofi-clouds">
    <div class="cloud-group c1"><div class="cloud-base"><div class="cloud-light"></div></div></div>
    <div class="cloud-group c2"><div class="cloud-base"><div class="cloud-light"></div></div></div>
</div>
<canvas id="fw-canvas"></canvas>

<div id="shop-overlay">
